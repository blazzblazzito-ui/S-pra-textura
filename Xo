    <script>
        /* --- ESTADO E CONFIGURAÇÃO --- */
        let scene, camera, renderer;
        let isGameStarted = false;
        let isPaused = false;
        let gameStartTime = 0;
        
        const settings = {
            fov: 75,
            sensitivity: 1.0,
            quality: 'medium',
            pixelRatio: 0.85
        };

        const keys = { forward: false, backward: false, left: false, right: false, sprint: false, crouch: false, jump: false };
        const joystick = { active: false, x: 0, y: 0 };
        const touchLook = { active: false, id: null, lastX: 0, lastY: 0 };

        // Física do Jogador
        const player = {
            height: 1.65,
            crouchHeight: 0.95,
            currentHeight: 1.65,
            radius: 0.35,
            position: new THREE.Vector3(0, 1.65, 0),
            velocity: new THREE.Vector3(),
            pitch: 0,
            yaw: 0,
            isGrounded: true,
            stamina: 100,
            maxStamina: 100,
            isExhausted: false,
            battery: 100,
            flashlightOn: true,
            isCrouching: false,
            isSprinting: false
        };

        // Grade do Labirinto e Física de Colisões
        const GRID_SIZE = 22;
        const CELL_SIZE = 4;
        const WALL_HEIGHT = 3.2;
        let mazeGrid = [];
        let doors = [];
        let collisionBoxes = [];

        // Iluminação e Monstro
        let flashlightSpotlight, flashlightPointlight, flashlightModel, flashlightTarget;
        let monster;
        let audioCtx, chaseSoundGain;

        /* --- TEXTURAS PROCEDURAIS --- */
        function createYellowWallpaperTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256; canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#bfa855';
            ctx.fillRect(0, 0, 256, 256);

            ctx.fillStyle = '#a89244';
            for (let x = 0; x < 256; x += 16) ctx.fillRect(x, 0, 8, 256);

            ctx.strokeStyle = '#8a7736';
            ctx.lineWidth = 1;
            for (let y = 0; y < 256; y += 32) {
                for (let x = 0; x < 256; x += 32) {
                    ctx.strokeRect(x + 4, y + 4, 24, 24);
                }
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            return texture;
        }

        function createCarpetTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256; canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#5c522c';
            ctx.fillRect(0, 0, 256, 256);

            ctx.fillStyle = 'rgba(30, 25, 10, 0.35)';
            for (let i = 0; i < 10; i++) {
                ctx.beginPath();
                ctx.arc(Math.random()*256, Math.random()*256, 15 + Math.random()*25, 0, Math.PI*2);
                ctx.fill();
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            return texture;
        }

        function createCeilingTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128; canvas.height = 128;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#a3a093';
            ctx.fillRect(0, 0, 128, 128);

            ctx.strokeStyle = '#44423b';
            ctx.lineWidth = 3;
            ctx.strokeRect(0, 0, 128, 128);

            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            return texture;
        }

        /* --- CONFIGURAÇÃO THREE.JS --- */
        function initThree() {
            const container = document.getElementById('game-container');

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0a05);
            scene.fog = new THREE.FogExp2(0x0a0a05, 0.08);

            camera = new THREE.PerspectiveCamera(settings.fov, window.innerWidth / window.innerHeight, 0.1, 40);
            camera.rotation.order = 'YXZ';
            scene.add(camera);

            renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: 'high-performance' });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(settings.pixelRatio);
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 0.85;
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0x666644, 0.5);
            scene.add(ambientLight);

            buildOptimizedMaze();
            setupFlashlight();
            setupMonster();

            window.addEventListener('resize', onWindowResize);
        }

        /* --- CONSTRUÇÃO DO LABIRINTO E CAIXAS DE COLISÃO RÍGIDAS --- */
        function buildOptimizedMaze() {
            collisionBoxes = [];

            const wallTex = createYellowWallpaperTexture();
            const wallMat = new THREE.MeshStandardMaterial({ map: wallTex, roughness: 0.8 });

            const carpetTex = createCarpetTexture();
            carpetTex.repeat.set(GRID_SIZE, GRID_SIZE);
            const floorMat = new THREE.MeshStandardMaterial({ map: carpetTex, roughness: 0.9 });

            const ceilingTex = createCeilingTexture();
            ceilingTex.repeat.set(GRID_SIZE / 2, GRID_SIZE / 2);
            const ceilingMat = new THREE.MeshStandardMaterial({ map: ceilingTex, roughness: 0.7 });

            const planeGeo = new THREE.PlaneGeometry(GRID_SIZE * CELL_SIZE, GRID_SIZE * CELL_SIZE);
            
            const floor = new THREE.Mesh(planeGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            scene.add(floor);

            const ceiling = new THREE.Mesh(planeGeo, ceilingMat);
            ceiling.position.y = WALL_HEIGHT;
            ceiling.rotation.x = Math.PI / 2;
            scene.add(ceiling);

            mazeGrid = Array(GRID_SIZE).fill(0).map(() => Array(GRID_SIZE).fill(0));

            // Paredes externas
            for (let i = 0; i < GRID_SIZE; i++) {
                mazeGrid[0][i] = 1;
                mazeGrid[GRID_SIZE - 1][i] = 1;
                mazeGrid[i][0] = 1;
                mazeGrid[i][GRID_SIZE - 1] = 1;
            }

            // Salas e corredores
            for (let r = 2; r < GRID_SIZE - 2; r += 2) {
                for (let c = 2; c < GRID_SIZE - 2; c += 2) {
                    if (Math.random() > 0.35) {
                        mazeGrid[r][c] = 1;
                        const dir = Math.floor(Math.random() * 4);
                        if (dir === 0 && r + 1 < GRID_SIZE - 1) mazeGrid[r + 1][c] = 1;
                        else if (dir === 1 && c + 1 < GRID_SIZE - 1) mazeGrid[r][c + 1] = 1;
                    }
                }
            }

            // Área do jogador no centro
            const startX = Math.floor(GRID_SIZE / 2);
            const startZ = Math.floor(GRID_SIZE / 2);
            mazeGrid[startX][startZ] = 0;
            mazeGrid[startX + 1][startZ] = 0;
            mazeGrid[startX - 1][startZ] = 0;
            mazeGrid[startX][startZ + 1] = 0;
            mazeGrid[startX][startZ - 1] = 0;

            player.position.set((startX - GRID_SIZE / 2) * CELL_SIZE, player.height, (startZ - GRID_SIZE / 2) * CELL_SIZE);
            camera.position.copy(player.position);

            const wallGeo = new THREE.BoxGeometry(CELL_SIZE, WALL_HEIGHT, CELL_SIZE);
            const wallInstanced = new THREE.InstancedMesh(wallGeo, wallMat, GRID_SIZE * GRID_SIZE);
            
            let instanceIdx = 0;
            const dummy = new THREE.Object3D();

            for (let r = 0; r < GRID_SIZE; r++) {
                for (let c = 0; c < GRID_SIZE; c++) {
                    const posX = (r - GRID_SIZE / 2) * CELL_SIZE;
                    const posZ = (c - GRID_SIZE / 2) * CELL_SIZE;

                    if (mazeGrid[r][c] === 1) {
                        dummy.position.set(posX, WALL_HEIGHT / 2, posZ);
                        dummy.updateMatrix();
                        wallInstanced.setMatrixAt(instanceIdx++, dummy.matrix);

                        // REGISTRA AABB DE PAREDE PARA COLISÃO FÍSICA
                        collisionBoxes.push(new THREE.Box3(
                            new THREE.Vector3(posX - CELL_SIZE / 2, 0, posZ - CELL_SIZE / 2),
                            new THREE.Vector3(posX + CELL_SIZE / 2, WALL_HEIGHT, posZ + CELL_SIZE / 2)
                        ));
                    } else if (r > 2 && r < GRID_SIZE - 2 && c > 2 && c < GRID_SIZE - 2) {
                        const hasNorth = mazeGrid[r - 1][c] === 1;
                        const hasSouth = mazeGrid[r + 1][c] === 1;
                        const hasWest = mazeGrid[r][c - 1] === 1;
                        const hasEast = mazeGrid[r][c + 1] === 1;

                        if (((hasNorth && hasSouth && !hasWest && !hasEast) || (hasWest && hasEast && !hasNorth && !hasSouth)) && Math.random() < 0.3) {
                            const isHorizontal = hasWest && hasEast;
                            createRoomDoor(posX, posZ, isHorizontal, wallMat);
                        }
                    }
                }
            }

            wallInstanced.count = instanceIdx;
            wallInstanced.instanceMatrix.needsUpdate = true;
            scene.add(wallInstanced);
        }

        /* --- PORTA COM COLISÃO DINÂMICA --- */
        function createRoomDoor(x, z, isHorizontal, wallMat) {
            const doorGroup = new THREE.Group();
            doorGroup.position.set(x, 0, z);

            if (isHorizontal) {
                doorGroup.rotation.y = Math.PI / 2;
            }

            const sideWidth = (CELL_SIZE - 1.8) / 2;
            const sideWallGeo = new THREE.BoxGeometry(sideWidth, WALL_HEIGHT, 0.4);
            
            const leftFrameWall = new THREE.Mesh(sideWallGeo, wallMat);
            const leftX = -(CELL_SIZE / 2) + (sideWidth / 2);
            leftFrameWall.position.set(leftX, WALL_HEIGHT / 2, 0);
            
            const rightFrameWall = new THREE.Mesh(sideWallGeo, wallMat);
            const rightX = (CELL_SIZE / 2) - (sideWidth / 2);
            rightFrameWall.position.set(rightX, WALL_HEIGHT / 2, 0);

            const topHeaderGeo = new THREE.BoxGeometry(1.8, WALL_HEIGHT - 2.3, 0.4);
            const topHeaderWall = new THREE.Mesh(topHeaderGeo, wallMat);
            topHeaderWall.position.set(0, WALL_HEIGHT - ((WALL_HEIGHT - 2.3) / 2), 0);

            doorGroup.add(leftFrameWall, rightFrameWall, topHeaderWall);

            if (isHorizontal) {
                collisionBoxes.push(new THREE.Box3(new THREE.Vector3(x - 0.2, 0, z + leftX - sideWidth/2), new THREE.Vector3(x + 0.2, WALL_HEIGHT, z + leftX + sideWidth/2)));
                collisionBoxes.push(new THREE.Box3(new THREE.Vector3(x - 0.2, 0, z + rightX - sideWidth/2), new THREE.Vector3(x + 0.2, WALL_HEIGHT, z + rightX + sideWidth/2)));
            } else {
                collisionBoxes.push(new THREE.Box3(new THREE.Vector3(x + leftX - sideWidth/2, 0, z - 0.2), new THREE.Vector3(x + leftX + sideWidth/2, WALL_HEIGHT, z + 0.2)));
                collisionBoxes.push(new THREE.Box3(new THREE.Vector3(x + rightX - sideWidth/2, 0, z - 0.2), new THREE.Vector3(x + rightX + sideWidth/2, WALL_HEIGHT, z + 0.2)));
            }

            const hingeGroup = new THREE.Group();
            hingeGroup.position.set(-0.9, 0, 0);

            const doorMat = new THREE.MeshStandardMaterial({ color: 0x5a3d1f, roughness: 0.8 });
            const panelGeo = new THREE.BoxGeometry(1.8, 2.3, 0.12);
            const panel = new THREE.Mesh(panelGeo, doorMat);
            panel.position.set(0.9, 1.15, 0);
            hingeGroup.add(panel);

            doorGroup.add(hingeGroup);
            scene.add(doorGroup);

            let doorBox;
            if (isHorizontal) {
                doorBox = new THREE.Box3(new THREE.Vector3(x - 0.15, 0, z - 0.9), new THREE.Vector3(x + 0.15, WALL_HEIGHT, z + 0.9));
            } else {
                doorBox = new THREE.Box3(new THREE.Vector3(x - 0.9, 0, z - 0.15), new THREE.Vector3(x + 0.9, WALL_HEIGHT, z + 0.15));
            }

            doors.push({
                group: doorGroup,
                hinge: hingeGroup,
                isOpen: false,
                position: new THREE.Vector3(x, 0, z),
                targetRot: 0,
                currentRot: 0,
                box: doorBox
            });
        }

        /* --- CARREGAMENTO DIRETO DO MODELO .OBJ CUSTOMIZADO DA LANTERNA --- */
        function setupFlashlight() {
            const torchGroup = new THREE.Group();
            
            flashlightTarget = new THREE.Object3D();
            flashlightTarget.position.set(0, 0, -5);
            torchGroup.add(flashlightTarget);

            flashlightSpotlight = new THREE.SpotLight(0xfffaed, 4.0, 26, Math.PI / 5, 0.3, 1);
            flashlightSpotlight.position.set(0, 0, -0.16);
            flashlightSpotlight.target = flashlightTarget;
            torchGroup.add(flashlightSpotlight);

            flashlightPointlight = new THREE.PointLight(0xfffaed, 0.6, 2.5);
            flashlightPointlight.position.set(0, 0, -0.16);
            torchGroup.add(flashlightPointlight);

            // Carregamento direto sem gerar malha genérica temporária
            const textureLoader = new THREE.TextureLoader();
            const textureUrl = 'https://cdn.jsdelivr.net/gh/blazzblazzito-ui/S-pra-textura@main/FlashlightTexture.png';
            const objUrl = 'https://cdn.jsdelivr.net/gh/blazzblazzito-ui/S-pra-textura@main/Flashlight.obj';

            textureLoader.load(
                textureUrl,
                (texture) => {
                    if (typeof THREE.OBJLoader !== 'undefined') {
                        const loader = new THREE.OBJLoader();
                        loader.load(
                            objUrl,
                            (obj) => {
                                obj.traverse((child) => {
                                    if (child.isMesh) {
                                        child.material = new THREE.MeshStandardMaterial({
                                            map: texture,
                                            roughness: 0.5,
                                            metalness: 0.2
                                        });
                                    }
                                });

                                // CORREÇÃO DE ORIENTAÇÃO: Rotaciona 180° no eixo Y para apontar para a frente
                                obj.rotation.y = Math.PI;

                                // Normaliza e dimensiona a lanterna (AUMENTADA PARA 0.38)
                                const box = new THREE.Box3().setFromObject(obj);
                                const size = new THREE.Vector3();
                                box.getSize(size);
                                const maxDim = Math.max(size.x, size.y, size.z);
                                if (maxDim > 0) {
                                    const scale = 0.38 / maxDim;
                                    obj.scale.set(scale, scale, scale);
                                }

                                torchGroup.add(obj);
                            },
                            undefined,
                            (err) => {
                                console.warn('Falha ao carregar arquivo OBJ da lanterna:', err);
                            }
                        );
                    }
                },
                undefined,
                (err) => {
                    console.warn('Falha ao carregar imagem de textura da lanterna:', err);
                }
            );

torchGroup.position.set(0.28, -0.22, -0.45);
            camera.add(torchGroup);
            flashlightModel = torchGroup;
        }

