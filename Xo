            const eyeMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
            const leftEye = new THREE.Mesh(eyeGeo, eyeMat);
            leftEye.position.set(-0.12, 2.2, -0.15);
            const rightEye = new THREE.Mesh(eyeGeo, eyeMat);
            rightEye.position.set(0.12, 2.2, -0.15);
            monsterGroup.add(leftEye, rightEye);

            const redLight = new THREE.PointLight(0xff0000, 1.8, 7);
            redLight.position.set(0, 2.0, 0);
            monsterGroup.add(redLight);

            const spawnX = (1 - GRID_SIZE / 2) * CELL_SIZE;
            const spawnZ = (1 - GRID_SIZE / 2) * CELL_SIZE;

            monsterGroup.position.set(spawnX, 0, spawnZ);
            scene.add(monsterGroup);

            monster = {
                mesh: monsterGroup,
                state: 'PATROL',
                speed: 2.3,
                chaseSpeed: 4.6,
                targetPos: new THREE.Vector3(),
                chaseTimer: 0
            };

            pickMonsterTarget();
        }

        function pickMonsterTarget() {
            let rx, rz, gridR, gridC;
            do {
                gridR = Math.floor(Math.random() * (GRID_SIZE - 2)) + 1;
                gridC = Math.floor(Math.random() * (GRID_SIZE - 2)) + 1;
            } while (mazeGrid[gridR][gridC] === 1);

            rx = (gridR - GRID_SIZE / 2) * CELL_SIZE;
            rz = (gridC - GRID_SIZE / 2) * CELL_SIZE;
            monster.targetPos.set(rx, 0, rz);
        }

        function updateMonsterAI(delta) {
            if (!monster || !isGameStarted) return;

            if (Date.now() - gameStartTime < 3000) return;

            const monsterPos = monster.mesh.position;
            const distToPlayer = monsterPos.distanceTo(player.position);

            const isPlayerRunning = player.isSprinting && player.velocity.length() > 0.1;

            if (distToPlayer < 14 || (distToPlayer < 20 && isPlayerRunning)) {
                monster.state = 'CHASE';
                monster.targetPos.copy(player.position);
                monster.chaseTimer = 5.0;
            } else if (monster.state === 'CHASE') {
                monster.chaseTimer -= delta;
                if (monster.chaseTimer <= 0) {
                    monster.state = 'PATROL';
                    pickMonsterTarget();
                }
            }

            const curSpeed = (monster.state === 'CHASE') ? monster.chaseSpeed : monster.speed;
            const dir = new THREE.Vector3().subVectors(monster.targetPos, monsterPos);
            dir.y = 0;

            if (dir.length() > 0.4) {
                dir.normalize();
                monsterPos.addScaledVector(dir, curSpeed * delta);
                monster.mesh.lookAt(monster.targetPos.x, monsterPos.y, monster.targetPos.z);
            } else if (monster.state === 'PATROL') {
                pickMonsterTarget();
            }

            const chaseOverlay = document.getElementById('chase-overlay');
            const monsterStatus = document.getElementById('monster-status');

            if (monster.state === 'CHASE' && distToPlayer < 15) {
                chaseOverlay.style.opacity = '1';
                monsterStatus.style.opacity = '1';
                if (chaseSoundGain) chaseSoundGain.gain.setValueAtTime(0.3, audioCtx.currentTime);
            } else {
                chaseOverlay.style.opacity = '0';
                monsterStatus.style.opacity = '0';
                if (chaseSoundGain) chaseSoundGain.gain.setValueAtTime(0, audioCtx.currentTime);
            }

            // HITBOX DE MORTE DA CRIATURA
            if (distToPlayer < 2.2) {
                triggerGameOver();
            }
        }

        /* --- SISTEMA DE ÁUDIO --- */
        function initAudio() {
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();

            const humOsc = audioCtx.createOscillator();
            const humGain = audioCtx.createGain();
            humOsc.type = 'sawtooth';
            humOsc.frequency.setValueAtTime(60, audioCtx.currentTime);
            humGain.gain.setValueAtTime(0.012, audioCtx.currentTime);
            humOsc.connect(humGain);
            humGain.connect(audioCtx.destination);
            humOsc.start();

            const chaseOsc = audioCtx.createOscillator();
            chaseSoundGain = audioCtx.createGain();
            chaseOsc.type = 'sawtooth';
            chaseOsc.frequency.setValueAtTime(45, audioCtx.currentTime);
            chaseSoundGain.gain.setValueAtTime(0, audioCtx.currentTime);
            chaseOsc.connect(chaseSoundGain);
            chaseSoundGain.connect(audioCtx.destination);
            chaseOsc.start();
        }

        function playClickSound() {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.frequency.setValueAtTime(550, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
            gain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 0.05);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.05);
        }

        /* --- CONTROLES MULTI-TOUCH E TECLADO --- */
        function setupInputs() {
            window.addEventListener('keydown', (e) => {
                if (!isGameStarted || isPaused) return;
                switch (e.code) {
                    case 'KeyW': case 'ArrowUp': keys.forward = true; break;
                    case 'KeyS': case 'ArrowDown': keys.backward = true; break;
                    case 'KeyA': case 'ArrowLeft': keys.left = true; break;
                    case 'KeyD': case 'ArrowRight': keys.right = true; break;
                    case 'ShiftLeft': keys.sprint = true; break;
                    case 'ControlLeft': case 'KeyC': keys.crouch = !keys.crouch; break;
                    case 'Space': keys.jump = true; break;
                    case 'KeyF': toggleFlashlight(); break;
                    case 'KeyE': interactDoor(); break;
                    case 'Escape': togglePauseMenu(); break;
                }
            });

            window.addEventListener('keyup', (e) => {
                switch (e.code) {
                    case 'KeyW': case 'ArrowUp': keys.forward = false; break;
                    case 'KeyS': case 'ArrowDown': keys.backward = false; break;
                    case 'KeyA': case 'ArrowLeft': keys.left = false; break;
                    case 'KeyD': case 'ArrowRight': keys.right = false; break;
                    case 'ShiftLeft': keys.sprint = false; break;
                    case 'Space': keys.jump = false; break;
                }
            });

            renderer.domElement.addEventListener('click', () => {
                if (isGameStarted && !isPaused && !isTouchDevice()) {
                    renderer.domElement.requestPointerLock();
                }
            });

            document.addEventListener('mousemove', (e) => {
                if (document.pointerLockElement === renderer.domElement && !isPaused) {
                    const sens = settings.sensitivity * 0.002;
                    player.yaw -= e.movementX * sens;
                    player.pitch -= e.movementY * sens;
                    player.pitch = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, player.pitch));
                }
            });

            setupTouchControls();
        }

        function setupTouchControls() {
            const joystickZone = document.getElementById('joystick-zone');
            const joystickThumb = document.getElementById('joystick-thumb');
            let joystickTouchId = null, center = { x: 0, y: 0 };

            const bindTouchBtn = (elemId, onPress, onRelease) => {
                const btn = document.getElementById(elemId);
                if (!btn) return;

                const handlePress = (e) => {
                    if (e) { e.preventDefault(); e.stopPropagation(); }
                    btn.classList.add('btn-active');
                    if (onPress) onPress();
                };

                const handleRelease = (e) => {
                    if (e) { e.preventDefault(); e.stopPropagation(); }
                    btn.classList.remove('btn-active');
                    if (onRelease) onRelease();
                };

                btn.addEventListener('touchstart', handlePress, { passive: false });
                btn.addEventListener('touchend', handleRelease, { passive: false });
            };

            bindTouchBtn('btn-flashlight', () => { toggleFlashlight(); });
            bindTouchBtn('btn-sprint', () => { keys.sprint = true; }, () => { keys.sprint = false; });
            bindTouchBtn('btn-crouch', () => { keys.crouch = !keys.crouch; });
            bindTouchBtn('btn-jump', () => { keys.jump = true; setTimeout(() => keys.jump = false, 100); });
            bindTouchBtn('btn-interact', () => { interactDoor(); });

            // Joystick Virtual
            joystickZone.addEventListener('touchstart', (e) => {
                e.preventDefault();
                const touch = e.changedTouches[0];
                joystickTouchId = touch.identifier;
                const rect = joystickZone.getBoundingClientRect();
                center = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
                joystick.active = true;
            }, { passive: false });

            window.addEventListener('touchmove', (e) => {
                if (joystick.active) {
                    for (let i = 0; i < e.changedTouches.length; i++) {
                        if (e.changedTouches[i].identifier === joystickTouchId) {
                            const touch = e.changedTouches[i];
                            const dx = touch.clientX - center.x;
                            const dy = touch.clientY - center.y;
                            const dist = Math.min(50, Math.hypot(dx, dy));
                            const angle = Math.atan2(dy, dx);

                            joystick.x = (dist / 50) * Math.cos(angle);
                            joystick.y = (dist / 50) * Math.sin(angle);
                            joystickThumb.style.transform = `translate(${joystick.x * 35}px, ${joystick.y * 35}px)`;
                            break;
                        }
                    }
                }

                if (touchLook.active) {
                    for (let i = 0; i < e.changedTouches.length; i++) {
                        const touch = e.changedTouches[i];
                        if (touch.identifier === touchLook.id) {
                            const dx = touch.clientX - touchLook.lastX;
                            const dy = touch.clientY - touchLook.lastY;
                            const sens = settings.sensitivity * 0.0035;
                            player.yaw -= dx * sens;
                            player.pitch -= dy * sens;
                            player.pitch = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, player.pitch));
                            touchLook.lastX = touch.clientX;
                            touchLook.lastY = touch.clientY;
                        }
                    }
                }
            }, { passive: false });

            window.addEventListener('touchend', (e) => {
                for (let i = 0; i < e.changedTouches.length; i++) {
                    const touch = e.changedTouches[i];
                    if (touch.identifier === joystickTouchId) {
                        joystick.active = false;
                        joystick.x = 0; joystick.y = 0;
                        joystickThumb.style.transform = `translate(0px, 0px)`;
                    }
                    if (touch.identifier === touchLook.id) {
                        touchLook.active = false;
                        touchLook.id = null;
                    }
                }
            });

            window.addEventListener('touchstart', (e) => {
                for (let i = 0; i < e.changedTouches.length; i++) {
                    const touch = e.changedTouches[i];
                    if (touch.clientX > window.innerWidth / 2 && !touchLook.active) {
                        const isBtn = touch.target.closest('#mobile-controls button');
                        if (!isBtn) {
                            touchLook.active = true;
                            touchLook.id = touch.identifier;
                            touchLook.lastX = touch.clientX;
                            touchLook.lastY = touch.clientY;
                        }
                    }
                }
            });
        }

        function isTouchDevice() {
            return ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        }

        /* --- FÍSICA E COLISÃO EXATA DE CAIXA BBOX 3D --- */
        let headBobTimer = 0;

        function updatePlayer(delta) {
            if (!isGameStarted || isPaused) return;

            // Bateria
            if (player.flashlightOn) {
                player.battery = Math.max(0, player.battery - delta * 0.7);
                if (player.battery === 0) {
                    player.flashlightOn = false;
                    flashlightSpotlight.visible = false;
                    flashlightPointlight.visible = false;
                }
            }
            document.getElementById('battery-bar').style.width = `${player.battery}%`;
            document.getElementById('battery-text').innerText = `${Math.round(player.battery)}%`;

            let moveX = 0, moveZ = 0;
            if (keys.forward) moveZ -= 1;
            if (keys.backward) moveZ += 1;
            if (keys.left) moveX -= 1;
            if (keys.right) moveX += 1;

            if (joystick.active) {
                moveX = joystick.x;
                moveZ = joystick.y;
            }

            const isMoving = Math.hypot(moveX, moveZ) > 0.1;

            if (keys.sprint && isMoving && !player.isCrouching && !player.isExhausted) {
                player.isSprinting = true;
                player.stamina = Math.max(0, player.stamina - delta * 20);
                if (player.stamina === 0) { player.isExhausted = true; player.isSprinting = false; }
            } else {
                player.isSprinting = false;
                player.stamina = Math.min(player.maxStamina, player.stamina + delta * 14);
                if (player.stamina > 20) player.isExhausted = false;
            }

            document.getElementById('stamina-bar').style.width = `${player.stamina}%`;
            document.getElementById('stamina-text').innerText = `${Math.round(player.stamina)}%`;

            let speed = 2.6;
            if (player.isSprinting) speed = 5.0;
            if (keys.crouch) { speed = 1.3; player.isCrouching = true; } else { player.isCrouching = false; }

            const targetHeight = player.isCrouching ? player.crouchHeight : player.height;
            player.currentHeight += (targetHeight - player.currentHeight) * 10 * delta;

            const forward = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
            const side = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
            const moveVec = new THREE.Vector3().addScaledVector(forward, -moveZ).addScaledVector(side, moveX);

            if (moveVec.length() > 1) moveVec.normalize();

            player.velocity.x = moveVec.x * speed;
            player.velocity.z = moveVec.z * speed;

            if (keys.jump && player.isGrounded && !player.isCrouching) {
                player.velocity.y = 3.6;
                player.isGrounded = false;
            }
            if (!player.isGrounded) player.velocity.y -= 11 * delta;

            const nextX = player.position.x + player.velocity.x * delta;
            const nextZ = player.position.z + player.velocity.z * delta;

            // SISTEMA FÍSICO DE DETECÇÃO DE CAIXA DE COLISÃO
            if (!checkBoundingBoxCollision(nextX, player.position.z)) {
                player.position.x = nextX;
            }
            if (!checkBoundingBoxCollision(player.position.x, nextZ)) {
                player.position.z = nextZ;
            }

            player.position.y += player.velocity.y * delta;
            if (player.position.y <= player.currentHeight) {
                player.position.y = player.currentHeight;
                player.velocity.y = 0;
                player.isGrounded = true;
            }

            // Câmera e Balanço
            camera.position.copy(player.position);

            if (isMoving && player.isGrounded) {
                const bobSpeed = player.isSprinting ? 8.0 : 4.8;
                headBobTimer += delta * bobSpeed;
                
                const bobY = Math.sin(headBobTimer) * (player.isSprinting ? 0.035 : 0.018);
                const bobX = Math.cos(headBobTimer * 0.5) * (player.isSprinting ? 0.018 : 0.009);
                
                camera.position.y += bobY;
                camera.position.x += bobX;

                if (flashlightModel) {
                    flashlightModel.position.x = 0.28 + Math.cos(headBobTimer * 0.5) * 0.012;
                    flashlightModel.position.y = -0.22 + Math.sin(headBobTimer) * 0.012;
                }
            }

            camera.rotation.y = player.yaw;
            camera.rotation.x = player.pitch;

            checkDoorPrompt();
        }

        // ALGORITMO DE COLISÃO AABB ULTRA-PRECISO
        function checkBoundingBoxCollision(x, z) {
            const r = player.radius;
            const playerBox = new THREE.Box3(
                new THREE.Vector3(x - r, 0, z - r),
                new THREE.Vector3(x + r, player.currentHeight, z + r)
            );

            // Testar colisão com todas as paredes registradas
            for (let box of collisionBoxes) {
                if (playerBox.intersectsBox(box)) return true;
            }

            // Testar colisão com portas fechadas
            for (let door of doors) {
                if (!door.isOpen && door.box) {
                    if (playerBox.intersectsBox(door.box)) return true;
                }
            }

            return false;
        }

        /* --- ANIMAÇÃO SUAVE DE ABERTURA REALISTA DE PORTAS (0° a 90°) --- */
        function interactDoor() {
            for (let door of doors) {
                if (door.position.distanceTo(player.position) < 2.8) {
                    door.isOpen = !door.isOpen;
                    door.targetRot = door.isOpen ? -Math.PI / 2 : 0;
                    playClickSound();
                    break;
                }
            }
        }

        function checkDoorPrompt() {
            const prompt = document.getElementById('interaction-prompt');
            let near = false;
            for (let door of doors) {
                if (door.position.distanceTo(player.position) < 2.5) { near = true; break; }
            }
    function updateDoors(delta) {
            doors.forEach(door => {
                door.currentRot += (door.targetRot - door.currentRot) * 7 * delta;
                door.hinge.rotation.y = door.currentRot;
            });
        }

